# DeepSeek (OpenAI-совместимый API)
DEEPSEEK_API=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
CALCULATOR_URL=https://www.melke.ru/wincalc/

# PostgreSQL + pgvector (каталог продукции и векторная база знаний RAG)
# Значения для запуска с хоста; в docker compose приложение получает POSTGRES_HOST=db,
# POSTGRES_PORT=5432 (см. docker-compose.yml).
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Backend: адреса frontend для CORS через запятую и предельное время ответа агента.
# Таймаут большой, потому что первый запрос загружает модель эмбеддингов RAG (~5 минут).
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
AGENT_TURN_TIMEOUT=600
# Уровень логов приложения в контейнере (INFO — видны причины и тайминги хода)
LOG_LEVEL=INFO

# NLU-слой: заготовленные ответы FAQ до вызова модели.
# FAQ_ENABLED=false — отключить слой; порог близости (0.93 — подобран на FAQ-датасете)
FAQ_ENABLED=true
FAQ_MATCH_THRESHOLD=0.93
